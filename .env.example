# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# ─── MongoDB Atlas / MongoDB ────────────────────────────────────────────────
# Put your free MongoDB Atlas connection string here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=gcarbon_resume_ai

# ─── AI (Gemini) ───────────────────────────────────────────────────────────────
# Keep all AI provider keys in your local .env only. Get a free key at
# https://aistudio.google.com/apikey — no credit card required.
# GEMINI_API_KEY=

# JWT Secret for signing auth tokens (generate with `openssl rand -base64 32`)
JWT_SECRET=

# ─── Email / SMTP ───────────────────────────────────────────────────────────────
# Used for password-reset emails.
# For development, use https://ethereal.email (free, no real emails sent).
# For production, use your SMTP provider (e.g. Resend, SendGrid, Mailgun, Gmail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Gcarbon Resume AI <no-reply@example.com>

# Base URL of the frontend — used to build the password-reset link in emails.
APP_BASE_URL=http://localhost:5173
